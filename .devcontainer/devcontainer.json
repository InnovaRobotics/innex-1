{
  "name": "INNEX-1 (ROS 2 Humble)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "ROS_SNAPSHOT": ""
    }
  },
  "workspaceFolder": "/workspace/innex-1",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/innex-1,type=bind",
  "remoteUser": "rover",
  "updateRemoteUserUID": true,
  "runArgs": [
    "--network=host",
    "--ipc=host",
    "--pid=host",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix",
    "--volume=/dev:/dev",
    "--privileged"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
    "PULSE_SERVER": "${localEnv:PULSE_SERVER}"
  },
  "postCreateCommand": "pre-commit install && echo 'Dev container ready. Run: ros2 doctor'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml",
        "platformio.platformio-ide"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  }
}
