<?xml version="1.0"?>
<robot name="innex_1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Will replace with proper values when rover is measured -->
  <xacro:property name="chassis_length" value="1.000"/>
  <xacro:property name="chassis_width" value="0.430"/>
  <xacro:property name="chassis_height" value="0.480"/>
  <xacro:property name="chassis_ground_clearance" value="0.240"/>
  <xacro:property name="chassis_x_offset" value="0.107"/>
  <xacro:property name="wheel_radius" value="0.154"/>
  <xacro:property name="wheel_width" value="0.125"/>
  <xacro:property name="wheelbase" value="0.705"/>
  <xacro:property name="track" value="0.614"/>

  <!-- will get proper masses when rover is weighed -->
  <xacro:property name="chassis_mass" value="56.0"/>
  <xacro:property name="wheel_mass" value="1.0"/>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia ixx="${mass / 12 * (y * y + z * z)}" ixy="0" ixz="0"
             iyy="${mass / 12 * (x * x + z * z)}" iyz="0"
             izz="${mass / 12 * (x * x + y * y)}"/>
  </xacro:macro>

  <link name="base_link"/>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${chassis_x_offset} 0 ${chassis_ground_clearance + chassis_height / 2}"/>
  </joint>

  <link name="chassis">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
    </inertial>
  </link>

</robot>