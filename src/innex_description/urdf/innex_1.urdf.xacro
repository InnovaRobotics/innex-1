<?xml version="1.0"?>
<robot name="innex_1" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:arg name="sim_cameras" default="true"/>

  <!-- Will replace with proper values when rover is measured -->
  <xacro:property name="chassis_length" value="1.060"/>
  <xacro:property name="chassis_width" value="0.470"/>
  <xacro:property name="chassis_height" value="0.530"/>
  <xacro:property name="chassis_ground_clearance" value="0.180"/>
  <xacro:property name="chassis_x_offset" value="0.024"/>
  <xacro:property name="rail_size" value="0.030"/>
  <xacro:property name="post_size" value="0.0225"/>
  <xacro:property name="ladder_overhang" value="0.150"/>
  <xacro:property name="ladder_width" value="0.165"/>
  <xacro:property name="wheel_radius" value="0.153"/>
  <xacro:property name="wheel_width" value="0.125"/>
  <xacro:property name="front_axle_x" value="0.5385"/>
  <xacro:property name="rear_axle_x" value="-0.5140"/>
  <xacro:property name="wheelbase" value="${front_axle_x - rear_axle_x}"/>
  <xacro:property name="track" value="0.675"/>

  <!-- will get proper masses when rover is weighed -->
  <xacro:property name="chassis_mass" value="51.0"/>
  <xacro:property name="wheel_mass" value="1.14"/>

  <material name="carbon">
    <color rgba="0.20 0.21 0.23 1"/>
  </material>
  <material name="panel">
    <color rgba="0.52 0.55 0.60 1"/>
  </material>
  <material name="bed">
    <color rgba="0.28 0.29 0.32 1"/>
  </material>
  <material name="tyre">
    <color rgba="0.07 0.07 0.08 1"/>
  </material>
  <material name="paddle">
    <color rgba="0.16 0.16 0.18 1"/>
  </material>
  <material name="hub">
    <color rgba="0.7 0.7 0.72 1"/>
  </material>
  <material name="accent">
    <color rgba="1.0 0.45 0.0 1"/>
  </material>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia ixx="${mass / 12 * (y * y + z * z)}" ixy="0" ixz="0"
             iyy="${mass / 12 * (x * x + z * z)}" iyz="0"
             izz="${mass / 12 * (x * x + y * y)}"/>
  </xacro:macro>

  <xacro:macro name="frame_tier" params="tier z_pos">
    <visual name="${tier}_left_rail">
      <origin xyz="0 ${(chassis_width - rail_size) / 2} ${z_pos}"/>
      <geometry>
        <box size="${chassis_length} ${rail_size} ${rail_size}"/>
      </geometry>
      <material name="carbon"/>
    </visual>
    <visual name="${tier}_right_rail">
      <origin xyz="0 ${-(chassis_width - rail_size) / 2} ${z_pos}"/>
      <geometry>
        <box size="${chassis_length} ${rail_size} ${rail_size}"/>
      </geometry>
      <material name="carbon"/>
    </visual>
    <visual name="${tier}_front_rail">
      <origin xyz="${(chassis_length - rail_size) / 2} 0 ${z_pos}"/>
      <geometry>
        <box size="${rail_size} ${chassis_width - 2 * rail_size} ${rail_size}"/>
      </geometry>
      <material name="carbon"/>
    </visual>
    <visual name="${tier}_rear_rail">
      <origin xyz="${-(chassis_length - rail_size) / 2} 0 ${z_pos}"/>
      <geometry>
        <box size="${rail_size} ${chassis_width - 2 * rail_size} ${rail_size}"/>
      </geometry>
      <material name="carbon"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="corner_post" params="post x_sign y_sign">
    <visual name="${post}_post">
      <origin xyz="${x_sign * (chassis_length - rail_size) / 2} ${y_sign * (chassis_width - rail_size) / 2} 0"/>
      <geometry>
        <box size="${post_size} ${post_size} ${chassis_height - 2 * rail_size}"/>
      </geometry>
      <material name="carbon"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="rocker_visual" params="side y_sign">
    <visual name="${side}_rocker_front">
      <origin xyz="0.337 ${y_sign * (chassis_width / 2 + 0.020)} -0.151" rpy="0 0.672 0"/>
      <geometry>
        <box size="0.453 0.015 0.042"/>
      </geometry>
      <material name="panel"/>
    </visual>
    <visual name="${side}_rocker_rear">
      <origin xyz="-0.060 ${y_sign * (chassis_width / 2 + 0.020)} -0.110" rpy="0 -0.426 0"/>
      <geometry>
        <box size="0.484 0.015 0.042"/>
      </geometry>
      <material name="panel"/>
    </visual>
    <visual name="${side}_bogie_bar">
      <origin xyz="-0.281 ${y_sign * (chassis_width / 2 + 0.035)} -0.275"/>
      <geometry>
        <box size="0.530 0.015 0.038"/>
      </geometry>
      <material name="panel"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="ladder_bucket" params="idx s_pos">
    <xacro:property name="ladder_angle" value="${36 * pi / 180}"/>
    <visual name="ladder_bucket_${idx}">
      <origin xyz="${0.37 + s_pos * cos(ladder_angle) + 0.060 * sin(ladder_angle)} 0 ${-0.02 - s_pos * sin(ladder_angle) + 0.060 * cos(ladder_angle)}" rpy="0 ${ladder_angle} 0"/>
      <geometry>
        <box size="0.045 ${ladder_width - 0.006} 0.035"/>
      </geometry>
      <material name="carbon"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="wheel_paddle" params="idx">
    <xacro:property name="angle" value="${idx * pi / 4}"/>
    <visual name="paddle_${idx}">
      <origin xyz="${(wheel_radius - 0.005) * cos(angle)} 0 ${(wheel_radius - 0.005) * sin(angle)}" rpy="0 ${-angle} 0"/>
      <geometry>
        <box size="0.012 ${wheel_width - 0.004} 0.010"/>
      </geometry>
      <material name="paddle"/>
    </visual>
  </xacro:macro>

  <link name="base_link"/>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${chassis_x_offset} 0 ${chassis_ground_clearance + chassis_height / 2}"/>
  </joint>

  <link name="chassis">
    <xacro:frame_tier tier="bottom" z_pos="${-chassis_height / 2 + rail_size / 2}"/>
    <xacro:frame_tier tier="middle" z_pos="0"/>
    <xacro:frame_tier tier="top" z_pos="${chassis_height / 2 - rail_size / 2}"/>
    <xacro:corner_post post="front_left" x_sign="1" y_sign="1"/>
    <xacro:corner_post post="front_right" x_sign="1" y_sign="-1"/>
    <xacro:corner_post post="rear_left" x_sign="-1" y_sign="1"/>
    <xacro:corner_post post="rear_right" x_sign="-1" y_sign="-1"/>
    <xacro:rocker_visual side="left" y_sign="1"/>
    <xacro:rocker_visual side="right" y_sign="-1"/>
    <visual name="electronics_enclosure">
      <origin xyz="${-chassis_length / 2 + rail_size + 0.250} 0 ${chassis_height / 2 - 0.060}"/>
      <geometry>
        <box size="0.500 ${chassis_width - 2 * rail_size} 0.110"/>
      </geometry>
      <material name="panel"/>
    </visual>
    <visual name="dump_bed">
      <origin xyz="-0.19 0 -0.14" rpy="0 ${-10.62 * pi / 180} 0"/>
      <geometry>
        <box size="0.640 0.324 0.110"/>
      </geometry>
      <material name="bed"/>
    </visual>
    <visual name="bucket_ladder">
      <origin xyz="0.37 0 -0.02" rpy="0 ${36 * pi / 180} 0"/>
      <geometry>
        <box size="0.760 ${ladder_width} 0.090"/>
      </geometry>
      <material name="panel"/>
    </visual>
    <xacro:ladder_bucket idx="0" s_pos="-0.24"/>
    <xacro:ladder_bucket idx="1" s_pos="-0.08"/>
    <xacro:ladder_bucket idx="2" s_pos="0.08"/>
    <xacro:ladder_bucket idx="3" s_pos="0.24"/>
    <visual name="front_plate">
      <origin xyz="${chassis_length / 2 + 0.005} 0 ${chassis_height / 2 - rail_size / 2}"/>
      <geometry>
        <box size="0.008 ${chassis_width - 0.06} 0.026"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <collision name="body">
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <collision name="ladder">
      <origin xyz="${chassis_length / 2 + ladder_overhang / 2} 0 -0.06"/>
      <geometry>
        <box size="${ladder_overhang} ${ladder_width} 0.360"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.08"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x_pos y">
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x_pos} ${y * track / 2} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${name}_wheel">
      <visual name="tyre">
        <origin rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius - 0.005}" length="${wheel_width}"/>
        </geometry>
        <material name="tyre"/>
      </visual>
      <xacro:wheel_paddle idx="0"/>
      <xacro:wheel_paddle idx="1"/>
      <xacro:wheel_paddle idx="2"/>
      <xacro:wheel_paddle idx="3"/>
      <xacro:wheel_paddle idx="4"/>
      <xacro:wheel_paddle idx="5"/>
      <xacro:wheel_paddle idx="6"/>
      <xacro:wheel_paddle idx="7"/>
      <visual name="hub">
        <origin xyz="0 ${y * (wheel_width / 2 + 0.004)} 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="0.09" length="0.008"/>
        </geometry>
        <material name="hub"/>
      </visual>
      <visual name="spoke">
        <origin xyz="0 ${y * (wheel_width / 2 + 0.009)} 0"/>
        <geometry>
          <box size="0.17 0.010 0.026"/>
        </geometry>
        <material name="accent"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}" ixy="0" ixz="0"
                 iyy="${wheel_mass * wheel_radius * wheel_radius / 2}" iyz="0"
                 izz="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel name="front_left" x_pos="${front_axle_x}" y="1"/>
  <xacro:wheel name="front_right" x_pos="${front_axle_x}" y="-1"/>
  <xacro:wheel name="middle_left" x_pos="0.0" y="1"/>
  <xacro:wheel name="middle_right" x_pos="0.0" y="-1"/>
  <xacro:wheel name="rear_left" x_pos="${rear_axle_x}" y="1"/>
  <xacro:wheel name="rear_right" x_pos="${rear_axle_x}" y="-1"/>

  <xacro:include filename="sensors/oak_d_pro.xacro"/>

  <!-- Downward camera pitch (15 deg) covers near ground while keeping beacon in view -->
  <xacro:property name="camera_pitch" value="${15 * pi / 180}"/>

  <!-- Front and rear OAK-D Pro cameras -->
  <xacro:oak_d_pro prefix="oak_front" parent="chassis" pitch="${camera_pitch}"
                   sim_cameras="$(arg sim_cameras)">
    <origin xyz="${chassis_length / 2 + 0.01 + 0.023 / 2} 0 ${chassis_height / 2 - rail_size / 2}" rpy="0 0 0"/>
  </xacro:oak_d_pro>

  <xacro:oak_d_pro prefix="oak_rear" parent="chassis" pitch="${camera_pitch}"
                   sim_cameras="$(arg sim_cameras)">
    <origin xyz="${-chassis_length / 2 - 0.01 - 0.023 / 2} 0 ${chassis_height / 2 - rail_size / 2}" rpy="0 0 ${pi}"/>
  </xacro:oak_d_pro>

  <xacro:include filename="sensors/ouster_os1.xacro"/>

  <!-- Ouster OS1-128 LiDAR mounted on front-top chassis -->
  <xacro:ouster_os1 prefix="os_sensor" parent="chassis">
    <origin xyz="${chassis_length / 2 - 0.045} 0 ${chassis_height / 2}" rpy="0 0 0"/>
  </xacro:ouster_os1>

  <xacro:include filename="innex_1.gazebo.xacro"/>

</robot>
