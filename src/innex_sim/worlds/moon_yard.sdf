<?xml version="1.0"?>
<sdf version="1.9">
  <world name="moon_yard">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.1 0.1 0.12 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <include>
      <uri>model://moon_yard_terrain</uri>
      <name>moon_yard_terrain</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Arena walls: simulation geometry only. -->
    <model name="wall_north">
      <static>true</static>
      <pose>3.95 4.45 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.1 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.1 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>3.95 -0.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.1 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.1 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>7.95 2.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 4.4 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 4.4 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-0.05 2.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 4.4 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 4.4 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Zone markers: visual only, no collision. -->
    <model name="zone_markers">
      <static>true</static>
      <link name="link">
        <visual name="start_zone">
          <pose>1.0 3.4 0.002 0 0 0</pose>
          <geometry>
            <box>
              <size>2.0 2.0 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0.8 0 0.5</ambient>
            <diffuse>0 0.8 0 0.5</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
        <visual name="construction_zone">
          <pose>1.3 0.75 0.002 0 0 0</pose>
          <geometry>
            <box>
              <size>2.6 1.5 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0.3 1 0.5</ambient>
            <diffuse>0 0.3 1 0.5</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
        <visual name="berm_target_area">
          <pose>1.3 0.75 0.004 0 0 0</pose>
          <geometry>
            <box>
              <size>1.5 0.9 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
        <visual name="excavation_zone">
          <pose>6.525 2.2 0.002 0 0 0</pose>
          <geometry>
            <box>
              <size>2.75 4.4 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.4 0.7 0.5</ambient>
            <diffuse>1 0.4 0.7 0.5</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Beacon frame position and height are unconfirmed with the organisers. -->
    <include>
      <uri>model://apriltag_beacon</uri>
      <name>apriltag_beacon</name>
      <pose>0.25 4.38 0.3 0 0 0</pose>
    </include>

    <!-- Rock positions approximate rulebook Figure 2. -->
    <include>
      <uri>model://rock_a</uri>
      <name>rock_1</name>
      <pose>2.47 3.73 0 0 0 0.5</pose>
    </include>
    <include>
      <uri>model://rock_b</uri>
      <name>rock_2</name>
      <pose>4.79 4.0 0 0 0 1.2</pose>
    </include>
    <include>
      <uri>model://rock_c</uri>
      <name>rock_3</name>
      <pose>0.29 2.04 0 0 0 2.1</pose>
    </include>
    <include>
      <uri>model://rock_d</uri>
      <name>rock_4</name>
      <pose>4.55 1.35 0 0 0 0.8</pose>
    </include>
    <include>
      <uri>model://rock_a</uri>
      <name>rock_5</name>
      <pose>3.16 0.92 0 0 0 1.5</pose>
    </include>
    <include>
      <uri>model://rock_b</uri>
      <name>rock_6</name>
      <pose>2.8 0.52 0 0 0 0.3</pose>
    </include>
    <include>
      <uri>model://rock_c</uri>
      <name>rock_7</name>
      <pose>6.19 3.57 0 0 0 1.8</pose>
    </include>
    <include>
      <uri>model://rock_d</uri>
      <name>rock_8</name>
      <pose>7.53 3.91 0 0 0 2.6</pose>
    </include>
    <include>
      <uri>model://rock_a</uri>
      <name>rock_9</name>
      <pose>6.08 0.47 0 0 0 0.9</pose>
    </include>
  </world>
</sdf>
