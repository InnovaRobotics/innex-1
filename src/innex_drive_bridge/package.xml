<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>innex_drive_bridge</name>
  <version>0.0.0</version>
  <description>ROS 2 body velocity bridge with a watchdog and bounded serial writes</description>
  <maintainer email="344364293+Leo-P-1109@users.noreply.github.com">Leo-P-1109</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-serial</depend>
  <depend>rcl_interfaces</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
